# 중첩 앱 산출물 — 루트 .gitignore는 /node_modules·/.next/를 루트에만 고정한다
node_modules
.next
.vercel
.env*
!.env.example
# 에이전트 메모리(세션 산출물, 커밋 금지)
.claude/agent-memory/

# public 폴더 정적 이미지는 배포에 필요하므로 예외 처리(루트 *.png·*.jpg·*.jpeg 무시 규칙의 예외)
!public/*.png
!public/*.jpg
!public/*.jpeg
!public/*.svg
!public/*.ico

# 운영DB 초기화 번들(파생물·505KB, scripts/build-prod-db-bundle.mjs로 재생성)
sql/_prod_db_bundle.sql

# 세션 임시 검증 스크립트 (비밀값 포함 가능 — 커밋 원천 차단)
/tmp-*.mjs
/tmp-*.sql
