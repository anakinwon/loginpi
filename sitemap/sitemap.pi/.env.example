# sitemap.pi 환경변수 템플릿 — 실값은 .env.local(로컬)·Vercel 프로젝트 env 에만. 스키마 정본 src/env.ts (추가 시 두 곳 동시 수정)

# ── 앱 ─────────────────────────────────────────────
# 앱 공개 URL — Origin 검사(@pi/guard withAuthGuard)·메타. 로컬 http://localhost:3000
NEXT_PUBLIC_APP_URL=https://sitemap.pi
# Pi SDK sandbox — 운영 false, Pi testnet 앱(스테이징) true. localhost 는 자동 sandbox
NEXT_PUBLIC_PI_SANDBOX=false

# ── Pi 인증 ─────────────────────────────────────────
# 세션 HMAC 서명 키(32자 이상, 환경별 별도). 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PI_SESSION_SECRET=
# Pi Developer Portal sitemap 앱 API 키 — 결제(Phase 2)용, Phase 1 미사용
PI_API_KEY=
# Developer Portal 도메인 소유 검증 키 — /validation-key.txt 로 서빙(testnet·mainnet 앱별 값 다름)
PI_DOMAIN_VALIDATION_KEY=
# 관리자 Pi 사용자명(쉼표 구분) — 로그인 시 sys_user.role=ADMIN 승격. 목록에서 빼도 자동 강등 안 됨(DB 수동)
ADMIN_PI_USERNAMES=
# 관리자 Pi uid(쉼표 구분) — 설정 시 사용자명+uid 둘 다 일치해야 승격. uid 는 앱(testnet·mainnet)별 값이라 환경별로 등록
# ⚠ 운영 tier(APP_TIER=prod 또는 VERCEL_ENV=production)에서 ADMIN_PI_USERNAMES 를 쓰면 필수 — 미설정 시 빌드 env 검증 실패 + 런타임 승격 생략
ADMIN_PI_UIDS=
# 도메인 소유 확인 토큰(/sitemap-verify.txt) HMAC 키(32자 이상, 환경별 별도, PI_SESSION_SECRET 과 다른 값).
# 미설정 시 PI_SESSION_SECRET 폴백 — 세션 키와 용도가 섞이므로 운영은 반드시 등록. 값을 바꾸면 기존 토큰 전부 무효(등록자 재게시 필요)
SITEMAP_VERIFY_SECRET=

# ── DB (Supabase, 서버 전용 service_role — anon 키 사용 금지) ─────
# 운영 = sitemap 전용 프로젝트(public 스키마) / 개발·스테이징 = pi-nonprod 프로젝트 + SUPABASE_SCHEMA
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PostgREST 대상 스키마 — 운영은 비움(public), 비운영은 sitemap_dev / sitemap_stg (Supabase Exposed schemas 등록 필수)
SUPABASE_SCHEMA=

# 3-tier 라우팅(@pi/db) — APP_TIER 미설정이면 VERCEL_ENV 로 판정(production=prod·preview=staging·development=dev, 그 외 prod).
# ⚠ dev/staging tier 는 DEV_*/STAGING_* 필수 — 운영 자격증명으로 폴백하지 않는다(미설정 = 503 DB_UNAVAILABLE)
APP_TIER=
DEV_SUPABASE_URL=
DEV_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# 스테이징에서 운영 DB 를 읽기 전용으로 볼 때만: STAGING_DB_TARGET=prod-ro + PROD_RO_*
STAGING_DB_TARGET=
PROD_RO_SUPABASE_URL=
PROD_RO_SUPABASE_KEY=

# ── 마이그레이션 (scripts/db-migrate.mjs 전용 — 앱 런타임 미사용, Vercel 등록 금지) ─────
# Supabase Dashboard → Connect → Session pooler(5432) 접속 문자열. sslmode 파라미터는 붙이지 않음(스크립트가 TLS 강제)
SITEMAP_DEV_DATABASE_URL=
SITEMAP_STG_DATABASE_URL=
SITEMAP_PROD_DATABASE_URL=

# ── 빌드 ────────────────────────────────────────────
# 1 이면 env 검증 생략(CI·env 없는 로컬 빌드 전용 — 운영 빌드 금지)
# SKIP_ENV_VALIDATION=1
