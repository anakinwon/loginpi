{
  "name": "schema-pi",
  "version": "0.1.0",
  "private": true,
  "description": "schema.pi 데이터 표준사전 메타시스템 — loginpi 워크스페이스 멤버(sitemap/*), 공용 인증 @pi/auth(Next.js 16 · React 19 · Tailwind v4)",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "pi-i18n validate && next build --turbopack",
    "start": "next start -p 3002",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "i18n:translate": "pi-i18n translate",
    "i18n:validate": "pi-i18n validate",
    "i18n:audit": "pi-i18n audit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.101.0",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "3.1.1",
    "@pi/auth": "workspace:*",
    "@pi/guard": "workspace:*",
    "@pi/i18n": "workspace:*",
    "@pi/mon": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "@xyflow/react": "12.12.0",
    "codemirror": "6.0.2",
    "html-to-image": "1.11.11",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.0",
    "oracledb": "^6.10.0",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
