{
  "name": "schema-pi",
  "version": "0.1.0",
  "private": true,
  "description": "schema.pi 데이터 표준사전 메타시스템 — loginpi 워크스페이스 멤버(sitemap/*), 공용 인증 @pi/auth(Next.js 16 · React 19 · Tailwind v4)",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "next build --turbopack",
    "start": "next start -p 3002",
    "db:migrate": "node --env-file=.env.local scripts/db-migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@pi/auth": "workspace:*",
    "@pi/guard": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.2.7",
    "next-auth": "5.0.0-beta.31",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
