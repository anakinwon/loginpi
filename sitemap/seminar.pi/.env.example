# seminar.pi 환경변수 템플릿 — 실값은 .env.local(로컬)·Vercel 프로젝트 env 에만. 스키마 정본 src/env.ts (추가 시 두 곳 동시 수정)

# ── 앱 ─────────────────────────────────────────────
# 앱 공개 URL — Origin 검사(@pi/guard withAuthGuard)·메타. 로컬 http://localhost:3000
NEXT_PUBLIC_APP_URL=https://seminar.pi
# Pi SDK sandbox — 운영 false, Pi testnet 앱(스테이징) true. localhost 는 자동 sandbox
NEXT_PUBLIC_PI_SANDBOX=false
# 요금제 화면(/plan) 원화 참고 환산 표시 — 1(기본) 보임, 0 숨김. 결제·청구는 언제나 Pi(시세 환산)
NEXT_PUBLIC_PLAN_KRW_REF=1

# ── Pi 인증 ─────────────────────────────────────────
# 세션 HMAC 서명 키(32자 이상, 환경별 별도). 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PI_SESSION_SECRET=
# Pi Sign-In(OAuth) Client ID — Developer Portal > Pi Sign-In. 일반 브라우저 Pi 로그인(cafe.pi 동일). 미설정 = SDK 로그인만. 콜백 URI <앱URL>/auth/pi/callback 를 포털에 정확히 등록
NEXT_PUBLIC_PI_OAUTH_CLIENT_ID=
# Pi Browser 가 이 앱을 여는 Portal 포워딩 도메인(예: seminarNNNN.pinet.com — Portal 앱 화면 "Open app" 주소, testnet·mainnet 다름). 인증 API Origin 허용. 미설정 시 Pi Browser 로그인 POST 가 403 cross_origin_auth
NEXT_PUBLIC_PI_APP_DOMAIN=
# Google 로그인(NextAuth v5, 일반 브라우저) — cafe.pi 방식 로그인 통합(마스터 지시 2026-10-11). 셋 다 설정해야 활성, 운영은 AUTH_URL 두지 말 것
# AUTH_SECRET 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" / Google Cloud Console → OAuth 클라이언트 → 리디렉션 URI <앱URL>/api/auth/callback/google
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 1 이면 클라이언트에 Google 로그인 버튼 노출
NEXT_PUBLIC_GOOGLE_LOGIN=
# Pi Developer Portal seminar 앱 API 키 — 결제(Phase 2)용, Phase 1 미사용
PI_API_KEY=
# 크론 /api/cron/site-sts-sweep Bearer 비밀값(16자 이상, `openssl rand -hex 24`) — 미설정이면 크론 401(실행 안 함). 운영은 PAID 탭 검토 뒤 등록
CRON_SECRET=
# 애플리케이션 모니터링 → schema.pi(운영만) — 키는 schema.pi MON_INGEST_KEY 와 같은 값(32자 이상)
MON_INGEST_URL=https://schem.vercel.app/api/mon/ingest
MON_INGEST_KEY=
# Developer Portal 도메인 소유 검증 키 — /validation-key.txt 로 서빙(testnet·mainnet 앱별 값 다름)
PI_DOMAIN_VALIDATION_KEY=
# 관리자 Pi 사용자명(쉼표 구분) — 로그인 시 sys_user.role=ADMIN 승격. 목록에서 빼도 자동 강등 안 됨(DB 수동)
ADMIN_PI_USERNAMES=
# 관리자 Pi uid(쉼표 구분) — 설정 시 사용자명+uid 둘 다 일치해야 승격. uid 는 앱(testnet·mainnet)별 값이라 환경별로 등록
# ⚠ 운영 tier(APP_TIER=prod 또는 VERCEL_ENV=production)에서 ADMIN_PI_USERNAMES 를 쓰면 필수 — 미설정 시 빌드 env 검증 실패 + 런타임 승격 생략
ADMIN_PI_UIDS=


# ── DB (Supabase, 서버 전용 service_role — anon 키 사용 금지) ─────
# 운영 = seminar 전용 프로젝트(public 스키마) / 개발·스테이징 = pi-nonprod 프로젝트 + SUPABASE_SCHEMA
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# PostgREST 대상 스키마 — 운영은 비움(public), 비운영은 seminar_dev / seminar_stg (Supabase Exposed schemas 등록 필수)
SUPABASE_SCHEMA=

# 3-tier 라우팅(@pi/db) — APP_TIER 미설정이면 VERCEL_ENV 로 판정(production=prod·preview=staging·development=dev, 그 외 prod).
# ⚠ dev/staging tier 는 DEV_*/STAGING_* 필수 — 운영 자격증명으로 폴백하지 않는다(미설정 = 503 DB_UNAVAILABLE)
APP_TIER=
DEV_SUPABASE_URL=
DEV_SUPABASE_SERVICE_ROLE_KEY=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
# 스테이징에서 운영 DB 를 읽기 전용으로 볼 때만: STAGING_DB_TARGET=prod-ro + PROD_RO_*
STAGING_DB_TARGET=
PROD_RO_SUPABASE_URL=
PROD_RO_SUPABASE_KEY=

# ── 마이그레이션 (scripts/db-migrate.mjs 전용 — 앱 런타임 미사용, Vercel 등록 금지) ─────
# Supabase Dashboard → Connect → Session pooler(5432) 접속 문자열. sslmode 파라미터는 붙이지 않음(스크립트가 TLS 강제)
SEMINAR_DEV_DATABASE_URL=
SEMINAR_STG_DATABASE_URL=
SEMINAR_PROD_DATABASE_URL=

# ── 빌드 ────────────────────────────────────────────
# 1 이면 env 검증 생략(CI·env 없는 로컬 빌드 전용 — 운영 빌드 금지)
# SKIP_ENV_VALIDATION=1
# ── M0 카메라 실험실(/lab/camera, PRD_01) ─────────────
# 운영 빌드에서 실험실 허용 — '1' 일 때만 열림(R-P6). 실기기 시험 끝나면 Vercel 에서 제거
LAB_ENABLED=
# 기기 2대 연결 시그널링(Supabase Realtime broadcast, 테이블 미사용) — pi-nonprod 프로젝트 Project URL · publishable 키(ENV_GUIDE 3.4)
NEXT_PUBLIC_LAB_SUPABASE_URL=
NEXT_PUBLIC_LAB_SUPABASE_PUBLISHABLE_KEY=

# ── 미디어 엔진 Galápagos(media/, PRD_02) ─────────────
# 입장권 JWT HS256 서명 키(32자 이상) — 엔진 MEDIA_TOKEN_SECRET 과 같은 값. 서버 전용, 미설정 = 입장권 발급 503
MEDIA_TOKEN_SECRET=
# 엔진 관리 API Bearer 키(32자 이상) — 엔진 MEDIA_ADMIN_SECRET 과 같은 값. 서버 전용. 설정하면 음성 자막(chunk)을 무대(발표자·패널)만 쓰게 엔진에 역할을 묻는다(D-1)
MEDIA_ADMIN_SECRET=
# 엔진 시그널링 WebSocket 주소 — 로컬 ws://localhost:7880/signal, 운영 wss://… 미설정 = 화상 기능 숨김
NEXT_PUBLIC_MEDIA_WS_URL=

# ── TURN 단기 자격 증명(/api/media/turn, M2 ⑨) — 전부 서버 전용·선택, 미설정 = STUN 만 ─────
# 1순위 Cloudflare Realtime TURN — Cloudflare 대시보드 → Realtime → TURN Server 에서 키 생성 → Token ID · API Token(ENV_GUIDE 3.6)
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
# 2순위 HMAC(coturn use-auth-secret) — TURN 서버 주소(호스트만) · coturn static-auth-secret 과 같은 값
TURN_HOST=
TURN_SECRET=
# 자격 증명 수명(초) — 기본 3600
TURN_CREDENTIAL_TTL=

# ── 외부 AI(자막·번역·회의록 요약·합성 음성, 계획 M-1) — 서버 전용 ─────
# Google AI Studio API 키(ENV_GUIDE 3.6 — 계정 단위 키, cafe.pi 와 공유 가능). 미설정 = AI 기능 503 + 화면에서 숨김
GEMINI_API_KEY=
# 세미나(또는 대면 노트) 1건당 음성 처리 상한(분) — 기본 120. 넘으면 그 세미나 자막·회의록 중단(비용 폭주 차단)
SPEECH_MAX_MIN=
