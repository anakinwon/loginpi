# 중첩 앱 산출물 — 루트 .gitignore는 /node_modules·/.next/를 루트에만 고정한다
node_modules
.next
.vercel
.env*
!.env.example
# 에이전트 메모리(세션 산출물, 커밋 금지)
.claude/agent-memory/
# 배경 효과 wasm — scripts/copy-mediapipe.mjs 가 node_modules 에서 복사(26.8MB, 커밋 금지)
public/mediapipe/wasm
# 전사 시험 녹음·전사 결과(회의 음성·대화 내용 — 개인정보, 커밋 금지)
voice/
