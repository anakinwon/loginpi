{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true",
    "CLAUDE_FLOW_ENABLE_NATIVE_BRIDGE_ON_WINDOWS": "1",
    "WORKSPACE_ROOT": "C:/Users/anaki/workspace",
    "ECC_DISABLED_HOOKS": "pre:mcp-health-check,post:mcp-health-check,post:ecc-metrics-bridge,post:ecc-context-monitor,post:session-activity-tracker"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-bean-emoji.mjs"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/da-ddl-guard.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__supabase__apply_migration|mcp__supabase__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/da-ddl-guard.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/work-history-logger.mjs\" && node \"$CLAUDE_PROJECT_DIR/.claude/hooks/work-stats-refresh.mjs\"",
            "timeout": 20
          }
        ]
      },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-gate.mjs\"", "timeout": 300 }] }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/work-history-logger.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/model-advisor.mjs\"",
            "timeout": 10
          }
        ]
      },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-flush.mjs\"", "timeout": 10 }] }
    ],
    "SubagentStart": [
      {
        "matcher": "anakin_phase-decide",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/model-advisor.mjs\"",
            "timeout": 10
          }
        ]
      },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/request-graph-refresh.mjs\"", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-gate.mjs\" --base", "timeout": 15 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/request-graph-refresh.mjs\"", "timeout": 5 }] },
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-gate.mjs\"", "timeout": 600 }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-flush.mjs\"", "timeout": 10 }] },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/build-defect-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/site-menu-sync.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory",
  "statusLine": {
    "type": "command",
    "command": "bash $WORKSPACE_ROOT/loginpi/.claude/statusline.sh",
    "refreshInterval": 5
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*"
    ],
    "deny": [],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/subagent-statusline.mjs\""
  }
}
