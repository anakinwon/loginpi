{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "sentry": {
      "type": "http",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--python",
        "C:\\Users\\anaki\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        "C:\\Users\\anaki\\workspace\\loginpi"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "gemini": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "gemini-mcp-tool"]
    },
    "cloudinary": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "--package",
        "@cloudinary/asset-management",
        "--",
        "mcp",
        "start"
      ],
      "env": {
        "CLOUDINARY_URL": "${CLOUDINARY_URL}"
      }
    },
    "filesystem": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\anaki\\workspace\\loginpi"
      ]
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=hpcvltlqqjgexpwzhzig&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cstorage"
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "ruflo": {
      "command": "cmd",
      "args": ["/c", "ruflo", "mcp", "start"],
      "env": {
        "CLAUDE_FLOW_ENABLE_NATIVE_BRIDGE_ON_WINDOWS": "1"
      }
    },
    "ecc-memory-vault": {
      "command": "cmd",
      "args": ["/c", "ecc-memory-mcp"],
      "env": {
        "ECC_MEMORY_HARNESS": "claude"
      }
    }
  }
}
