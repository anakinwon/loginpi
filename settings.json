{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_TOOL_SEARCH": "true:5",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "MAX_THINKING_TOKENS": "8000",
    "OTEL_METRICS_EXPORTER": "otlp",
    "BASH_ENV": "/c/Users/anaki/.claude/bash-env.sh"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(git commit *)",
      "Bash(git * main)",
      "Bash(git push *)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Bash(curl *)",
      "Read(./secrets/**)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-fable-5[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "commit-commands@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "gitlab@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "figma@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "discord@claude-plugins-official": false,
    "notion@claude-plugins-official": false,
    "postman@claude-plugins-official": false,
    "mongodb@claude-plugins-official": false,
    "netlify-skills@claude-plugins-official": false,
    "data-engineering@claude-plugins-official": false,
    "data@claude-plugins-official": false,
    "shopify@claude-plugins-official": false,
    "zoominfo@claude-plugins-official": false,
    "zoom-plugin@claude-plugins-official": false,
    "sourcegraph@claude-plugins-official": false,
    "mcp-apps@claude-plugins-official": false,
    "serena@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": false,
    "example-skills@anthropic-agent-skills": false,
    "harness@harness-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "harness-marketplace": {
      "source": {
        "source": "github",
        "repo": "revfactory/harness"
      }
    }
  },
  "outputStyle": "Explanatory",
  "language": "korean",
  "alwaysThinkingEnabled": false,
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plans",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}